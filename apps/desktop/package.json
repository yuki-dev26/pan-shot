{
  "name": "@panshot/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "PanShot desktop app",
  "author": "PanShot",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder --mac --win",
    "build:unpack": "electron-vite build && electron-builder --dir",
    "build:mac": "electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac -c.mac.identity=null",
    "build:mac:signed": "bash scripts/build-mac-signed.sh",
    "build:win": "electron-vite build && electron-builder --win",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "@fontsource/outfit": "^5.2.8",
    "@fontsource/syne": "^5.2.7",
    "@panshot/shared": "workspace:*",
    "lucide-react": "^1.25.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7.0.4"
  },
  "build": {
    "appId": "app.panshot.desktop",
    "productName": "PanShot",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "resources/icon-mac.png",
      "type": "distribution",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}