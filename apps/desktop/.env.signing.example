# macOS 署名・公証用
# .env.signing は git に含めないこと
# cp apps/desktop/.env.signing.example apps/desktop/.env.signing

# Keychain の Developer ID Application 証明書名（security find-identity -v -p codesigning で確認）
CSC_NAME=

# Apple Developer の Team ID（メンバーシップ詳細で確認）
APPLE_TEAM_ID=

# 公証用 Apple ID（developer.apple.com と同じメール）
APPLE_ID=

# アプリ用パスワード（https://appleid.apple.com → サインイン → アプリ用パスワード）
APPLE_APP_SPECIFIC_PASSWORD=
